# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example is documentation, not a secret. It ships.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# review harness output
.shots/
.work/

# NOTE: source-assets/ is deliberately NOT ignored. It holds the client's
# original supplied artwork, and docs/CLAIMS.md cites those paths as the
# provenance for every product and image on the site. It is excluded from the
# deployed bundle by living outside public/, not by being excluded from git.

# Admin Dashboard uploads. Runtime state, never source.
/.data
